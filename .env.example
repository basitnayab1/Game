# =================================================================
# N5 Game Platform — Production Environment Configuration Template
# Copy this file to .env and replace all placeholders before deployment.
# NEVER COMMIT ACTUAL PRODUCTION PASSWORDS OR SECRETS TO GIT.
# =================================================================

# -----------------------------------------------------------------
# 1. PostgreSQL Database Credentials
# -----------------------------------------------------------------
POSTGRES_DB=n5_game
POSTGRES_USER=n5_admin
# Minimum 16 characters cryptographically random password
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# -----------------------------------------------------------------
# 2. Security & JWT Tokens (MANDATORY in Production, Min 32 Chars)
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_REFRESH_SECRET

# -----------------------------------------------------------------
# 3. Application Runtime & Networking
# -----------------------------------------------------------------
NODE_ENV=production
PORT=8080
API_PREFIX=/api/v1
APP_NAME=N5 Game
AUTO_MIGRATE=true

# Explicit CORS Origins (Comma-separated for multiple domains; wildcard '*' is forbidden in production)
CORS_ORIGIN=https://n5game.com,https://admin.n5game.com

# -----------------------------------------------------------------
# 4. Optional Real Payment Gateways (Sandbox / Production)
# -----------------------------------------------------------------
# Easypaisa Direct Merchant API
EASYPAISA_ENV=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_WEBHOOK_SECRET=

# JazzCash MWALLET API
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_HASH_KEY=
JAZZCASH_WEBHOOK_SECRET=

# -----------------------------------------------------------------
# 5. Optional OTP Providers (SMS / WhatsApp)
# -----------------------------------------------------------------
OTP_CHANNEL=both
WHATSAPP_SENDER_NUMBER=+923001234567
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=
# Required for inbound WhatsApp verification; the gateway must send it as the x-webhook-secret header
WHATSAPP_INBOUND_SECRET=
SMS_PROVIDER=console
SMS_SENDER_ID=N5GAME
SMS_API_KEY=
SMS_API_URL=https://api.veevotech.com/sendsms

# -----------------------------------------------------------------
# 6. Admin Initial Bootstrap (Run via CLI after container launch)
# Command: docker compose exec app npm run bootstrap:admin:prod -- --phone="+923001234567" --password="YourSecurePassword123!"
# -----------------------------------------------------------------
# ADMIN_PHONE="+923001234567"
# ADMIN_PASSWORD="<YourSecurePassword_Min_12_Chars>"
