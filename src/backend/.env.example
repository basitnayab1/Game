# =================================================================
# N5 Game Backend — Local & Production Configuration Template
# Never commit real production credentials to Git.
# =================================================================

NODE_ENV=development
PORT=8080
APP_NAME=N5 Game
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# Database & Cache (Supply via external secret manager in staging/production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/n5_game
REDIS_URL=redis://localhost:6379

# Security Tokens (Minimum 32 characters each)
JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_MIN_32_CHAR_REFRESH_SECRET
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12

# Database Migration
AUTO_MIGRATE=true
MIGRATIONS_DIR=

# SMS & WhatsApp OTP Providers
OTP_CHANNEL=both
WHATSAPP_SENDER_NUMBER=+923001234567
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=
# Required for inbound WhatsApp verification; the gateway must send it as the x-webhook-secret header
WHATSAPP_INBOUND_SECRET=
SMS_PROVIDER=console
SMS_SENDER_ID=N5GAME
SMS_API_KEY=
SMS_API_URL=https://api.veevotech.com/sendsms

# Real Payment Gateways (Easypaisa & JazzCash Sandbox)
EASYPAISA_ENV=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_WEBHOOK_SECRET=
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_HASH_KEY=
JAZZCASH_WEBHOOK_SECRET=

# KYC Verification Provider
KYC_PROVIDER=shuftipro
KYC_CLIENT_ID=
KYC_SECRET_KEY=
KYC_WEBHOOK_SECRET=
