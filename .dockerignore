# =================================================================
# N5 Game Platform — Docker Build Context Exclusions
# =================================================================

# Version Control & IDE
.git
.gitignore
.github
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Secrets & Local Config (CRITICAL: Never bake into image)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Node.js dependencies & package caches
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-store

# Local compilation outputs (built cleanly inside multi-stage Docker build)
**/dist
**/build
**/.next
**/.nuxt
*.tsbuildinfo
*.apk
*.idsig

# Test & Coverage Artifacts
**/coverage
**/test
**/tests
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
vitest.config.ts

# Temporary & Cache Directories
tmp
temp
**/scratch
.DS_Store
Thumbs.db
